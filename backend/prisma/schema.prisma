generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model todos {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt    @db.UnsignedBigInt
  title        String    @db.VarChar(255)
  description  String?   @db.Text
  is_completed Boolean   @default(false)
  due_at       DateTime? @db.DateTime(0)
  created_at   DateTime  @default(now()) @db.DateTime(0)
  updated_at   DateTime  @default(now()) @db.DateTime(0)
  action_id    String?   @unique(map: "action_id") @db.VarChar(255)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_todos_user")

  @@index([due_at], map: "idx_todos_due_at")
  @@index([user_id, is_completed], map: "idx_todos_user_completed")
  @@index([user_id], map: "idx_todos_user_id")
}

model users {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  email             String           @unique(map: "email") @db.VarChar(255)
  password_hash     String           @db.VarChar(255)
  first_name        String           @db.VarChar(100)
  last_name         String?          @db.VarChar(100)
  is_active         Boolean          @default(true)
  role              Role             @default(USER)
  email_verified_at DateTime?        @db.DateTime(0)
  created_at        DateTime         @default(now()) @db.DateTime(0)
  updated_at        DateTime         @default(now()) @db.DateTime(0)
  todos             todos[]
  refresh_tokens    refresh_tokens[]

  @@index([is_active], map: "idx_users_active")
}

model refresh_tokens {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt   @db.UnsignedBigInt
  token         String   @unique @db.VarChar(512)
  expires_at    DateTime @db.DateTime(0)
  is_revoked    Boolean  @default(false)
  created_at    DateTime @default(now()) @db.DateTime(0)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_refresh_tokens_user_id")
}

enum Role {
  USER
  ADMIN
}

model game_config {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name       String   @unique @db.VarChar(100)
  maps       Json
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)
}
